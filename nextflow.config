def systemCpus     = Runtime.getRuntime().availableProcessors()
def totalMemoryBytes = com.sun.management.OperatingSystemMXBean.class.isAssignableFrom(com.sun.management.OperatingSystemMXBean.class) ? 
                       ((com.sun.management.OperatingSystemMXBean) java.lang.management.ManagementFactory.getOperatingSystemMXBean()).getTotalPhysicalMemorySize() : 16L * 1024 * 1024 * 1024
def totalMemoryGb    = (totalMemoryBytes / (1024 * 1024 * 1024)).toInteger()

if (totalMemoryGb <= 0) { totalMemoryGb = 16 }

def targetCpus   = Math.max(1, (systemCpus * 0.85).toInteger())
def targetMemory = (totalMemoryGb * 0.85).toInteger()

executor {
    name   = 'local'
    cpus   = targetCpus
    memory = "${targetMemory}.GB"
    // Brak queueSize = 1 pozwala na pełną, równoległą pracę wielu procesów naraz!
}

params {
    samples_table    = "$launchDir/samples.csv"
    outdir           = "$launchDir/results"
    busco_lineage    = "fungi_odb10"
    outgroup         = null
    
    interproscan_db  = "/databases/interproscan"
    eggnog_db        = "/databases/eggnog"
    antismash_db     = "/databases/antismash"
}

process {
    container = 'mordziarz/fungi_pipeline:latest'

    withLabel: 'process_low' {
        cpus   = Math.min(4, Math.max(1, (targetCpus * 0.10).toInteger()))
        memory = "${Math.min(16, Math.max(4, (targetMemory * 0.10).toInteger()))}.GB"
    }
    withLabel: 'process_medium' {
        cpus   = Math.min(8, Math.max(2, (targetCpus * 0.25).toInteger()))
        memory = "${Math.min(32, Math.max(8, (targetMemory * 0.25).toInteger()))}.GB"
    }
    withLabel: 'process_high' {
        cpus   = Math.min(16, Math.max(4, (targetCpus * 0.50).toInteger()))
        memory = "${Math.min(64, Math.max(16, (targetMemory * 0.50).toInteger()))}.GB"
    }
    withLabel: 'process_maximum' {
        cpus   = Math.min(32, targetCpus)
        memory = "${Math.min(128, targetMemory)}.GB"
    }

    withName: 'FASTQC_RAW|FASTQC_TRIM' {
        label             = 'process_medium'
        env._JAVA_OPTIONS = "-Xmx${Math.min(24, (targetMemory * 0.25).toInteger())}g"
    }
    withName: 'FASTP' {
        label      = 'process_medium'
    }
    withName: 'JELLYFISH' {
        label      = 'process_high'
    }
    withName: 'SPADES' {
        label      = 'process_maximum'
    }
    withName: 'TIARA' {
        label      = 'process_high'
    }
    withName: 'ANTISMASH' {
        label             = 'process_maximum'
        env._JAVA_OPTIONS = "-Xmx${Math.min(96, (targetMemory * 0.75).toInteger())}g"
    }
    withName: 'BUSCO' {
        label      = 'process_high'
    }
    withName: 'REPEATMASKER' {
        label      = 'process_high'
    }
    withName: 'AUGUSTUS' {
        label      = 'process_high'
    }
    withName: 'PROTEIN_FASTA' {
        label      = 'process_low'
    }
    withName: 'EGGNOG_MAPPER' {
        label      = 'process_maximum'
    }
    withName: 'INTERPROSCAN' {
        label             = 'process_maximum'
        env._JAVA_OPTIONS = "-Xmx${Math.min(96, (targetMemory * 0.75).toInteger())}g"
    }
    withName: 'DEEPSIG|EFFECTORP' {
        label      = 'process_medium'
    }
    withName: 'ORTHOFINDER' {
        label      = 'process_maximum'
    }
    
    // Nowe procesy filogenomiczne:
    withName: 'MAFFT_ALIGN' {
        label      = 'process_medium'
    }
    withName: 'TRIMAL' {
        label      = 'process_low'
    }
    withName: 'ALIGNMENT_CONCATENATION' {
        label      = 'process_medium'
    }
    withName: 'RAXML' {
        label      = 'process_high'
    }
}

docker {
    enabled = true
    runOptions = "-u \$(id -u):\$(id -g) -v ${launchDir}/databases:/databases"
}

timeline { 
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_timeline.html"
    overwrite = true 
}
report { 
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_report.html"
    overwrite = true 
}
trace {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_trace.txt"
    overwrite = true
}
dag {
    enabled = true
    file    = "${params.outdir}/pipeline_info/pipeline_dag.html"
    overwrite = true
}
