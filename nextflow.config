def systemCpus = Runtime.getRuntime().availableProcessors()
def osBean = java.lang.management.ManagementFactory.getOperatingSystemMXBean()
def physicalMemoryBytes = 16L * 1024 * 1024 * 1024

try {
    if (osBean instanceof com.sun.management.OperatingSystemMXBean) {
        physicalMemoryBytes = ((com.sun.management.OperatingSystemMXBean) osBean).getTotalMemorySize()
    }
} catch (Exception ignored) {
    println "Could not detect physical memory. Using fallback."
}

def readMemoryLimit = { paths ->
    for (def path : paths) {
        try {
            def file = new File(path)
            if (file.exists()) {
                def value = file.text.trim()
                if (value.isLong()) {
                    def limit = value.toLong()
                    if (limit > 0 && limit < (1L << 60)) {
                        return limit
                    }
                }
            }
        } catch (Exception ignored) {}
    }
    return null
}

def cgroupMemory = readMemoryLimit([
    '/sys/fs/cgroup/memory.max',
    '/sys/fs/cgroup/memory/memory.limit_in_bytes'
])

def totalMemoryBytes = cgroupMemory != null ?
    Math.min(physicalMemoryBytes, cgroupMemory) :
    physicalMemoryBytes

def totalMemoryGb = Math.max(
    1,
    (totalMemoryBytes / (1024L * 1024L * 1024L)).toInteger()
)

def reservedMemoryGb
if (totalMemoryGb <= 8) {
    reservedMemoryGb = 2
} else if (totalMemoryGb <= 16) {
    reservedMemoryGb = 3
} else if (totalMemoryGb <= 32) {
    reservedMemoryGb = 4
} else {
    reservedMemoryGb = Math.max(4, (totalMemoryGb * 0.15).toInteger())
}

def targetMemory = Math.max(
    1,
    (totalMemoryGb * 0.70).toInteger()
)

targetMemory = Math.min(
    targetMemory,
    Math.max(1, totalMemoryGb - reservedMemoryGb)
)

def targetCpus = Math.max(
    1,
    (systemCpus * 0.70).toInteger()
)

executor {
    name = 'local'
    cpus = targetCpus
    memory = "${targetMemory}.GB"
    queueSize = Math.max(1, Math.min(4, targetCpus))
}

params {
    samples_table = "$launchDir/samples.csv"
    outdir = "$launchDir/results"
    busco_lineage = "fungi_odb10"
    outgroup = null
    interproscan_db = "/databases/interproscan"
    eggnog_db = "/databases/eggnog"
    antismash_db = "/databases/antismash"
}

def lowCpus = 1
def mediumCpus = Math.max(1, Math.min(2, (targetCpus * 0.25).toInteger()))
def highCpus = Math.max(1, Math.min(4, (targetCpus * 0.40).toInteger()))
def maximumCpus = Math.max(1, Math.min(8, (targetCpus * 0.60).toInteger()))

def lowMemory = Math.max(1, Math.min(4, (targetMemory * 0.15).toInteger()))
def mediumMemory = Math.max(1, Math.min(8, (targetMemory * 0.25).toInteger()))
def highMemory = Math.max(1, Math.min(16, (targetMemory * 0.40).toInteger()))
def maximumMemory = Math.max(1, Math.min(32, (targetMemory * 0.60).toInteger()))

process {
    container = 'mordziarz/fungi_pipeline:latest'
    errorStrategy = 'terminate'

    withLabel: 'process_low' {
        cpus = lowCpus
        memory = "${lowMemory}.GB"
    }

    withLabel: 'process_medium' {
        cpus = mediumCpus
        memory = "${mediumMemory}.GB"
    }

    withLabel: 'process_high' {
        cpus = highCpus
        memory = "${highMemory}.GB"
    }

    withLabel: 'process_maximum' {
        cpus = maximumCpus
        memory = "${maximumMemory}.GB"
    }

    withName: 'FASTQC_RAW|FASTQC_TRIM' {
        label = 'process_medium'
        env._JAVA_OPTIONS = "-Xmx${Math.max(1, Math.min(2, mediumMemory - 1))}g"
    }

    withName: 'FASTP' {
        label = 'process_medium'
    }

    withName: 'JELLYFISH' {
        label = 'process_high'
    }

    withName: 'SPADES' {
        label = 'process_maximum'
    }

    withName: 'TIARA' {
        label = 'process_medium'
    }

    withName: 'ANTISMASH' {
        label = 'process_high'
        env._JAVA_OPTIONS = "-Xmx${Math.max(1, Math.min(8, highMemory - 1))}g"
    }

    withName: 'BUSCO' {
        label = 'process_medium'
    }

    withName: 'REPEATMASKER' {
        label = 'process_medium'
    }

    withName: 'AUGUSTUS' {
        label = 'process_medium'
    }

    withName: 'PROTEIN_FASTA' {
        label = 'process_low'
    }

    withName: 'EGGNOG_MAPPER' {
        label = 'process_high'
    }

    withName: 'INTERPROSCAN' {
        label = 'process_high'
        env._JAVA_OPTIONS = "-Xmx${Math.max(1, Math.min(8, highMemory - 1))}g"
    }

    withName: 'DEEPSIG|EFFECTORP' {
        label = 'process_medium'
    }

    withName: 'ORTHOFINDER' {
        label = 'process_high'
    }

    withName: 'MAFFT_ALIGN' {
        label = 'process_medium'
    }

    withName: 'TRIMAL' {
        label = 'process_low'
    }

    withName: 'ALIGNMENT_CONCATENATION' {
        label = 'process_medium'
    }

    withName: 'RAXML' {
        label = 'process_high'
    }
}

docker {
    enabled = true
    runOptions = "-u \$(id -u):\$(id -g) -v ${launchDir}/databases:/databases"
}

timeline {
    enabled = true
    file = "${params.outdir}/pipeline_info/execution_timeline.html"
    overwrite = true
}

report {
    enabled = true
    file = "${params.outdir}/pipeline_info/execution_report.html"
    overwrite = true
}

trace {
    enabled = true
    file = "${params.outdir}/pipeline_info/execution_trace.txt"
    overwrite = true
}

dag {
    enabled = true
    file = "${params.outdir}/pipeline_info/pipeline_dag.html"
    overwrite = true
}
